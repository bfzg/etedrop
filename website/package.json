{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "docusaurus": "docusaurus",
    "prepare:i18n-layout": "node ./scripts/prepare-i18n-docs-layout.mjs international",
    "start": "node ./scripts/prepare-i18n-docs-layout.mjs international && docusaurus start --host 0.0.0.0 --locale en",
    "start:en": "node ./scripts/prepare-i18n-docs-layout.mjs international && docusaurus start --host 0.0.0.0 --locale en",
    "start:zh": "node ./scripts/prepare-i18n-docs-layout.mjs international && docusaurus start --host 0.0.0.0 --locale zh-Hans",
    "start:ja": "node ./scripts/prepare-i18n-docs-layout.mjs international && docusaurus start --host 0.0.0.0 --locale ja",
    "start:es": "node ./scripts/prepare-i18n-docs-layout.mjs international && docusaurus start --host 0.0.0.0 --locale es",
    "start:ko": "node ./scripts/prepare-i18n-docs-layout.mjs international && docusaurus start --host 0.0.0.0 --locale ko",
    "start:domestic": "node ./scripts/prepare-i18n-docs-layout.mjs domestic && DOMESTIC_SITE=1 docusaurus start --host 0.0.0.0 --locale zh-Hans",
    "preview": "node ./scripts/prepare-i18n-docs-layout.mjs international && docusaurus build && node ./scripts/dedupe-build-assets.mjs && docusaurus serve --host 0.0.0.0",
    "build": "node ./scripts/prepare-i18n-docs-layout.mjs international && docusaurus build && node ./scripts/dedupe-build-assets.mjs",
    "build:domestic": "node ./scripts/prepare-i18n-docs-layout.mjs domestic && DOMESTIC_SITE=1 docusaurus build && node ./scripts/dedupe-build-assets.mjs",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "postcss": "^8.5.6",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/tsconfig": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
