# =============================================================================
# EteDrop — 国内机「仅 80 + ACME」阶段（复制本段到服务器测 certbot 用）
#
# 与 nginx-etedrop-cn.conf.example 相同，但下面两段 listen 443 已全部注释。
# 签出 api-cn / cn 证书后：取消注释两段 443，或改回用 nginx-etedrop-cn.conf.example。
# =============================================================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream fast_send_backend {
    server 127.0.0.1:40321;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name api-cn.etedrop.com cn.etedrop.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

