# =============================================================================
#
# 域名约定：
#   - api.etedrop.cn              → 反代后端 127.0.0.1:40321
#   - etedrop.cn / www.etedrop.cn / *.etedrop.cn（泛解析）→ 官网静态
#
# 官网根目录（服务器本地路径，与域名后缀无关，可按实际改）：
# API：127.0.0.1:40321
#
# 证书示例（路径以 certbot 实际签发为准）：
#   sudo certbot certonly --webroot -w /var/www/html -d api.etedrop.cn
#   sudo certbot certonly --webroot -w /var/www/html -d etedrop.cn -d www.etedrop.cn
#   # 泛域名 *.etedrop.cn 通常需 DNS-01，例如：
#   # sudo certbot certonly --manual --preferred-challenges dns -d "*.etedrop.cn" -d etedrop.cn
#
# 若 /etc/nginx/nginx.conf 的 http{} 里已有同名 map，请删除本文件中的 map 段。
#
# 证书尚未签发、nginx -t 报 fullchain 不存在时：注释掉对应 listen 443 的整段 server。
# =============================================================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream fast_send_backend {
    server 127.0.0.1:40321;
    keepalive 32;
}

# ---------- HTTP：acme + 跳 HTTPS ----------
server {
    listen 80;
    listen [::]:80;
    server_name api.etedrop.cn etedrop.cn www.etedrop.cn *.etedrop.cn;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- HTTPS：API ----------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.etedrop.cn;

    ssl_certificate     /etc/letsencrypt/live/api.etedrop.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.etedrop.cn/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 500m;

    location / {
        proxy_pass http://fast_send_backend;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }
}

# ---------- HTTPS：官网（etedrop.cn 主域 + www + 泛域名）----------
# 证书需覆盖 etedrop.cn、www.etedrop.cn、*.etedrop.cn（泛域名多为单独一张证书，路径以 certbot 为准）
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name etedrop.cn www.etedrop.cn *.etedrop.cn;

    ssl_certificate     /etc/letsencrypt/live/etedrop.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/etedrop.cn/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /home/app/www.etedrop.cn;
    index index.html;

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot|webp|map)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    access_log /var/log/nginx/etedrop-cn-access.log;
    error_log  /var/log/nginx/etedrop-cn-error.log;
}
