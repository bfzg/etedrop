# =============================================================================
# EteDrop — 国内机 Nginx 示例（仅 api-cn + cn 官网镜像，无 api / etedrop 主域）
#
# 用途：国内 VPS 只承接 api-cn.etedrop.com 与 cn.etedrop.com 时，用本文件，避免
# 引用海外才存在的 /etc/letsencrypt/live/api.etedrop.com 等证书路径。
#
# 官网根目录：/home/app/www.etedrop.com/（与海外同源静态）
# API：127.0.0.1:40321
#
# 证书示例：
#   sudo certbot certonly --webroot -w /var/www/html -d api-cn.etedrop.com
#   sudo certbot certonly --webroot -w /var/www/html -d cn.etedrop.com
#
# 若 /etc/nginx/nginx.conf 的 http{} 里已有同名 map，请删除本文件中的 map 段。
#
# 证书尚未签发、nginx -t 报 fullchain 不存在时，可先用同目录
# **`nginx-etedrop-cn-acme-only.conf.example`**（仅 80，443 已注释），签完再换回本文件。
# =============================================================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream fast_send_backend {
    server 127.0.0.1:40321;
    keepalive 32;
}

# ---------- HTTP：acme + 跳 HTTPS ----------
server {
    listen 80;
    listen [::]:80;
    server_name api-cn.etedrop.com cn.etedrop.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- HTTPS：API 大陆线 ----------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api-cn.etedrop.com;

    ssl_certificate     /etc/letsencrypt/live/api-cn.etedrop.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api-cn.etedrop.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 500m;

    location / {
        proxy_pass http://fast_send_backend;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }
}

# ---------- HTTPS：官网镜像 cn ----------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name cn.etedrop.com;

    ssl_certificate     /etc/letsencrypt/live/cn.etedrop.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cn.etedrop.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /home/app/www.etedrop.com;
    index index.html;

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot|webp|map)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    access_log /var/log/nginx/etedrop-cn-access.log;
    error_log  /var/log/nginx/etedrop-cn-error.log;
}
