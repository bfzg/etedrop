# =============================================================================
# EteDrop — 全球节点 Nginx 示例（etedrop.com + api.etedrop.com）
#
# 部署位置：海外 / 国际访问入口服务器。
#
# 与客户端的关系：
#   Flutter 默认全球 API 为 `https://api.etedrop.com`（见
#   `fast_send_flutter/lib/core/config/server_endpoints.dart`）。
#   大陆用户选「国内线路」时改连 `https://api.etedrop.cn`，由**国内机**上
#   `doc/nginx-etedrop-cn.conf.example` 提供，**不必**在本机再挂 api-cn 域名。
#
# 本机需具备：
#   - 网站静态根：默认 /home/app/www.etedrop.com/（Docusaurus build 产物）
#   - 后端反代：127.0.0.1:40321（fast_send_server）
#
# 启用方式（与仓库其他 doc 一致）：
#   sudo cp nginx-etedrop.conf.example /etc/nginx/sites-available/etedrop
#   sudo ln -sf /etc/nginx/sites-available/etedrop /etc/nginx/sites-enabled/etedrop
#   # 若 http{} 里已有同名的 map，删本文件中的 map 段
#   sudo nginx -t && sudo systemctl reload nginx
#
# 证书（示例，按 certbot 实际输出改路径）：
#   sudo certbot certonly --webroot -w /var/www/html -d etedrop.com -d www.etedrop.com
#   sudo certbot certonly --webroot -w /var/www/html -d api.etedrop.com
# 若 nginx -t 报 /etc/letsencrypt/options-ssl-nginx.conf 不存在，
# 见 `doc/服务器部署文档.md` 的「Certbot SSL 参数文件」。
# =============================================================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream fast_send_backend {
    server 127.0.0.1:40321;
    keepalive 32;
}

# -----------------------------------------------------------------------------
# HTTP：ACME + 跳 HTTPS
# -----------------------------------------------------------------------------

server {
    listen 80;
    listen [::]:80;
    server_name api.etedrop.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name etedrop.com www.etedrop.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://etedrop.com$request_uri;
    }
}

# -----------------------------------------------------------------------------
# HTTPS：API（全球线）
# -----------------------------------------------------------------------------

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.etedrop.com;

    ssl_certificate     /etc/letsencrypt/live/api.etedrop.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.etedrop.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 500m;

    location / {
        proxy_pass http://fast_send_backend;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }
}

# -----------------------------------------------------------------------------
# HTTPS：官网 — www → 根域
# -----------------------------------------------------------------------------

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.etedrop.com;

    ssl_certificate     /etc/letsencrypt/live/etedrop.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/etedrop.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://etedrop.com$request_uri;
}

# -----------------------------------------------------------------------------
# HTTPS：官网 — etedrop.com 静态站
# -----------------------------------------------------------------------------

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name etedrop.com;

    ssl_certificate     /etc/letsencrypt/live/etedrop.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/etedrop.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /home/app/www.etedrop.com;
    index index.html;

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot|webp|map)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    access_log /var/log/nginx/etedrop-access.log;
    error_log  /var/log/nginx/etedrop-error.log;
}

